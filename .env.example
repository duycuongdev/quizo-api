# Application
APP_NAME=Quizo API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-to-a-strong-random-64-char-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array or comma-separated origins)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./quizo.db
# Production Neon PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-example.us-east-2.aws.neon.tech/quizo?sslmode=require

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Uploads & Rate Limits
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI=5/minute
